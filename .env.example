# ─────────────────────────────────────────────────────────────────────────────
# .env.example
#
# WHY: Documents every environment variable the application needs.
#      Developers copy this to `.env` locally. In production (GKE), these are
#      injected as Kubernetes ConfigMaps and Secrets — never baked into the image.
#      This file is safe to commit; `.env` is never committed (see .dockerignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1                      # Increase to match CPU cores in production

# ── vLLM Backend ─────────────────────────────────────────────────────────────
# The ClusterIP service URL of the vLLM deployment inside GKE.
# In production this is set via Kubernetes ConfigMap.
VLLM_BASE_URL=http://vllm-service:8001
VLLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
VLLM_TIMEOUT_SECONDS=120

# ── Request Limits ───────────────────────────────────────────────────────────
MAX_TOKENS_LIMIT=4096
DEFAULT_MAX_TOKENS=512
