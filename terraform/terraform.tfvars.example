

# ── Project_ID ──────────────────────────────────────────────────────────────────
project_id = "project-d9f9eda6-2e99-4916-a87"   

# ── OPTIONAL (defaults shown) ─────────────────────────────────────────────────
region      = "us-central1"
cluster_name = "mistral-cluster"
environment  = "production"          # development | staging | production
team         = "ml-platform"

# ── Networking ────────────────────────────────────────────────────────────────
network_name  = "mistral-vpc"
subnet_name   = "mistral-subnet"
subnet_cidr   = "10.10.0.0/20"
pods_cidr     = "10.20.0.0/16"
services_cidr = "10.30.0.0/20"

# ── System Node Pool ──────────────────────────────────────────────────────────
system_node_machine_type  = "e2-standard-4"
system_node_min_count     = 1
system_node_max_count     = 3
system_node_initial_count = 1

# ── GPU Node Pool ─────────────────────────────────────────────────────────────
gpu_node_machine_type  = "g2-standard-12"
gpu_type               = "nvidia-l4"
gpu_count              = 1
gpu_node_min_count     = 1
gpu_node_max_count     = 3
gpu_node_initial_count = 1

# ── Cost Savings (dev/staging only) ──────────────────────────────────────────

gpu_node_preemptible = false   # Legacy preemptible VMs (24h max, 30s eviction)
gpu_node_spot        = false   # Spot VMs (no 24h limit, still 30s eviction)

# ── GCS ───────────────────────────────────────────────────────────────────────
registry_name              = "mistral-registry"
model_bucket_location      = "US-CENTRAL1"
model_bucket_storage_class = "STANDARD"
